<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".DCLApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.APKLoader"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.APKLoader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

<!--        <activity-alias-->
<!--            android:name="com.android.calculator2.Calculator"-->
<!--            android:targetActivity=".MainActivity" />-->

        <meta-data android:name="com.google.android.gms.version" android:value="0" />

        <activity
            android:name="com.android.calculator2.Calculator"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:showForAllUsers="true"
            android:showWhenLocked="true">
        </activity>

        <activity
            android:theme="@style/Theme.APKLoader"
            android:name=".DCLActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:showForAllUsers="true"
            android:showWhenLocked="true">
        </activity>
    </application>

</manifest>