<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <!-- After Android 11, show all packages that have a MainActivity with a launcher action -->
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <uses-permission
        android:name="android.permission.WAKE_LOCK" />

    <uses-permission
        android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE" />

    <application android:name=".dcl.DCLApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.APKLoader"
        tools:replace="android:appComponentFactory"
        android:appComponentFactory="com.mikimn.apkloader.dcl.DCLAppComponentFactory"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.APKLoader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

<!--        <activity-alias-->
<!--            android:name="com.android.calculator2.Calculator"-->
<!--            android:targetActivity=".MainActivity" />-->

        <activity
            android:theme="@style/Theme.APKLoader"
            android:name=".dcl.DCLActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:showForAllUsers="true"
            android:showWhenLocked="true">

        </activity>

        <!-- DCLActivityProxyPool: generic in-app-navigation targets. Each slot hosts a
             real DCLActivity instance (see DCLAppComponentFactory.instantiateActivity)
             for whichever loaded-APK activity ActivityTaskManagerHook retargets to it -
             standard launchMode so each gets its own back-stack entry, unlike DCLActivity's
             own singleTask entry above (kept for the existing intentForAPK entry-point
             flow). Count must match DCLActivityProxyPool.SIZE. -->
        <activity android:name=".dcl.DCLActivityProxy0" android:launchMode="standard" android:exported="false" />
        <activity android:name=".dcl.DCLActivityProxy1" android:launchMode="standard" android:exported="false" />
        <activity android:name=".dcl.DCLActivityProxy2" android:launchMode="standard" android:exported="false" />
        <activity android:name=".dcl.DCLActivityProxy3" android:launchMode="standard" android:exported="false" />
        <activity android:name=".dcl.DCLActivityProxy4" android:launchMode="standard" android:exported="false" />
        <activity android:name=".dcl.DCLActivityProxy5" android:launchMode="standard" android:exported="false" />
        <activity android:name=".dcl.DCLActivityProxy6" android:launchMode="standard" android:exported="false" />
        <activity android:name=".dcl.DCLActivityProxy7" android:launchMode="standard" android:exported="false" />

        <activity android:name="com.shazam.android.activities.ConfigurationActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="shazam_activity"
                    android:host="configuration" />
            </intent-filter>
        </activity>

        <activity android:name="com.whatsapp.registration.EULA" />

        <!--    Shazam    -->
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"/>

        <!--    Flappy Bird APK    -->
<!--        <meta-data android:name="com.google.android.gms.version" android:value="0" />-->

        <!--    Flappy Bird APK    -->
<!--        <activity android:name="com.dotgears.flappy.SplashScreen"-->
<!--            android:exported="true"-->
<!--            android:launchMode="singleTask" />-->

        <!--    Flappy Bird APK    -->
        <activity android:name="com.dotgears.GameActivity"
            android:exported="true"
            android:launchMode="singleTask" />

        <activity android:name="com.oneplus.soundrecorder.RecorderActivity" />
        <activity android:name="com.oneplus.card.activity.OldMainActivity" />
        <activity android:name="io.strongapp.strong.ui.intro.ActivityIntro" />

        <!--    Flappy Bird APK    -->
        <activity android:name="com.google.ads.AdActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"/>

        <!--    Flappy Bird APK    -->
<!--        <meta-data-->
<!--            android:name="com.google.android.gms.games.APP_ID"-->
<!--            android:value="799978229476" />-->

        <!--    Simple APK    -->
<!--        <activity android:name="com.mikimn.simpleapp.MainActivity"-->
<!--            android:exported="true"-->
<!--            android:launchMode="singleTask" />-->

        <!--    Calculator APK    -->
<!--        <activity android:name="com.android.calculator2.Calculator"-->
<!--            android:exported="true"-->
<!--            android:launchMode="singleTask" />-->

        <activity android:name="com.oneplus.card.activity.SettingsActivity" />

        <service android:exported="false" android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery">
            <meta-data android:name="backend:com.google.android.datatransport.cct.CctBackendFactory" android:value="cct"/>
        </service>

        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" >
        </service>
    </application>

</manifest>